+const arkanUrl = readEnvLocal("ARKAN_VAULT_URL") || "http://127.0.0.1:8765";
+const isRemote = arkanUrl !== "http://127.0.0.1:8765";
+const arkanMode = arkanUrl.includes("tailnet") || arkanUrl.includes("ts.net") 
