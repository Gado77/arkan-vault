# Environment variables — copy to .env and adjust as needed

DEBUG=true
APP_NAME="Arkan Vault"
APP_VERSION="0.1.0"

# Paths (defaults are fine for local development)
# SQLITE_URL=sqlite:///./data/arkan.db
# CHROMA_PATH=./data/chroma
# MEMORIES_PATH=./data/memories
# FILES_PATH=./data/files
# MAX_UPLOAD_BYTES=53687091200
# MAX_EXTRACT_BYTES=2000000
# MAX_EXTRACT_CHARS=20000

# Embedding model (local via sentence-transformers)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
